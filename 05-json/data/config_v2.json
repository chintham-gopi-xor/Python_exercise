{
  "app": {
    "name": "TrainingPortal",
    "version": "1.5.0",
    "debug": true
  },
  "server": {
    "port": 8080,
    "timeouts": {
      "connect": 5,
      "read": 45
    },
    "workers": 4
  },
  "database": {
    "engine": "postgres",
    "host": "db.internal",
    "port": 5432,
    "pool": {
      "max": 10
    }
  },
  "features": {
    "signup": true,
    "beta_dashboard": false,
    "dark_mode": true
  },
  "admins": [
    "asha",
    "ben",
    "chen"
  ],
  "cache": {
    "ttl": 300,
    "backend": "redis"
  }
}
